# 服务端口
PORT=3001

# 飞书应用凭证 (从飞书开放平台获取 https://open.feishu.cn/app)
# 【安全警告】切勿把真实 secret 写入本模板文件, 真实值只应写在 .env 里
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# 飞书消息接收者
# FEISHU_RECEIVE_ID_TYPE 可选: open_id / union_id / user_id / email / chat_id
# 若 FEISHU_RECEIVE_ID 形如 oc_xxx 请填 chat_id；形如 ou_xxx 请填 open_id；形如 on_xxx 请填 union_id
FEISHU_RECEIVE_ID_TYPE=chat_id
FEISHU_RECEIVE_ID=oc_your_chat_id_here

# 清空历史数据接口 (/api/reset) 的鉴权 Token, 防止外人刷接口
# 建议设置为不易猜测的随机长字符串
CONFIG_AUTH_TOKEN=please_change_me_to_a_long_random_string

# 币安接口请求超时 (毫秒)
BINANCE_TIMEOUT_MS=10000

# ============ 近 1H 瞬时费率均值拥挤阈值 ============
# 均值 > +RATE1H_MIN_ABS  → 多头拥挤 (可做空)
# 均值 < -RATE1H_MIN_ABS  → 空头拥挤 (可做多)
# |均值| <= RATE1H_MIN_ABS → 市场中性
#
# 0.00005 = 0.5bp (推荐)
# 0.00003 = 偏宽松
# 0.0001  = 严格 (1bp)
RATE1H_MIN_ABS=0.00005

# 1H 均值生效所需最少采样点数 (每 90s 一个点, 10 = 约 15 分钟暖机)
# 启动后更快进入信号状态可调小, 比如 3
RATE1H_MIN_SAMPLES=10

# ============ Regime 宏观监控模块配置 ============
# 是否启用 regime 模块的飞书推送 (0 = 关闭, 其他 = 开启)
REGIME_FEISHU_ENABLED=1

# Regime 模块连续拉取失败多少次后推送告警
REGIME_FAIL_ALERT_THRESHOLD=3

# 只要你 不写 TRADING_NOTIFY_TG=1 ，Telegram 就 绝对不会 收到那些流水账消息（比如平仓、触发止盈止损等）。
TRADING_NOTIFY_TG=0

# ============ 通知状态持久化文件路径 (重启后不重复推送) ============
# 相对路径相对项目根, 默认会落在 ./data/ 下
# REGIME_NOTIFY_STATE_PATH=./data/regime_notify_state.json
# FUNDING_NOTIFY_STATE_PATH=./data/funding_notify_state.json

# ============ 飞书自定义机器人 Webhook 推送 (新版 Regime 关键信号) ============
# 触发场景：
#   - Regime 细分状态切换（强多头/弱多头/震荡/弱空头/强空头/恐慌）
#   - MACD 金叉 / 死叉
#   - RSI 进入超买(>=70) / 超卖(<=30) 区
#
# 如何获取 URL:
#   飞书群 → 设置 → 群机器人 → 添加机器人 → "自定义机器人"
#   复制 webhook 地址粘贴到这里。
#   若勾选了 "签名校验"，请同时填 FEISHU_WEBHOOK_SECRET。
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/cbbf7949-e7f5-4dd6-a257-d6e018ae563c
FEISHU_WEBHOOK_SECRET=IVO6tQ1vjxOyALOCPvZN5d

# 是否启用 Webhook (0 = 关闭, 其他 = 开启, 默认开启)
WEBHOOK_ENABLED=1

# 全局最小推送间隔 (毫秒)：任意两条 Webhook 消息之间至少间隔这么久
# 默认 30000 (30s), 避免 Webhook 被频繁调用
WEBHOOK_MIN_INTERVAL_MS=30000

# 同类事件冷却 (毫秒)：同一事件 key (regimeChange / macdCross_GOLDEN / rsiZone_OVERBOUGHT 等)
# 在冷却期内不会重复推送, 默认 300000 (5min)
WEBHOOK_EVENT_COOLDOWN_MS=300000

# ============ Regime 多周期共振信号 (1h/15m RSI+MACD × 5分钟/1分钟 MTF, 共四组) ============
# 「xx过」回溯窗口: RSI 超卖过/超买过、MACD 金叉过/死叉过 = 最近 N 根 K 线内曾发生 (含当根)
#   - 1h 组默认 6 根 (≈6 小时), 15m 组默认 8 根 (≈2 小时)
# 共振条件 (满足即推飞书, 四组各自独立去重, 状态持久化只推一次):
#   多头: {1h|15m} RSI 超卖过 + MACD 金叉过 + {5分钟|1分钟} MTF 强多
#   空头: {1h|15m} RSI 超买过 + MACD 死叉过 + {5分钟|1分钟} MTF 强空
REGIME_COMBO_LOOKBACK_1H=6
REGIME_COMBO_LOOKBACK_15M=8

# ============ 动态止盈止损 (未手动编辑过的价位自动跟随 regime ATR) ============
# 开启后每 60s 检查多/空 active 持仓: 未手动编辑过的 TP1/TP2/TP3/SL 按最新 1H ATR 重算
# (锚定原入场价, 与手动追单同公式: risk=1.5*ATR, TP1/2/3=entry±1/2/3*risk, SL=entry∓risk)
# 规则:
#   - 手动改过的价位 (adjust-levels / 页面编辑) 永久锁定不再动态调整; 未改过的继续跟随
#   - 已触发的 TP 不调; TP1 触发后 SL 不再动态调整 (保本/trailing 由风控套件接管)
#   - hardSlCap 同样生效; 单价位变化 < 0.05% 不动 (防抖)
# AUTO_TRADE_DYNAMIC_LEVELS=1                 # 0=关闭自动跟随, 改用持仓卡「🔄 更新TP/SL」按钮手动单次更新
# AUTO_TRADE_DYNAMIC_LEVELS_CHECK_MS=60000    # 检查间隔毫秒 (最小 15000)
# AUTO_TRADE_DYNAMIC_LEVELS_MIN_CHANGE_PCT=0.05  # 变化阈值 (% of entry)
#
# ⚗️ HV/ROC 增强 (实验性, 默认关): regime 页面「🧮 HV/ROC增强TP/SL」开关或
#    POST /api/auto-trade/toggle-hvroc-levels 切换 (运行时配置持久化, 非环境变量).
#    开启后 ATR 公式加 HV 波动率缩放 (0.8~1.3x) + ROC 动量止盈拉伸 (0.75~1.25x),
#    作用于手动开仓回退/追单/MTF自动开仓/动态止盈止损/持仓卡「更新TP/SL」「恢复自动TP/SL」按钮
#    (全部同一口径: 勾选=ATR+HV+ROC, 未勾选=纯 ATR); 对胜率的影响未经回测验证.

# ============ MTF 组合条件自动开仓 (regime 页面「手动开仓」栏「组合开多/组合开空」开关) ============
# 触发边缘: MTF 1分钟评分连续确认「转为」强多/强空; 触发时再验三重过滤, 全过才市价下单:
#   ① 大周期方向: MTF 240分钟 或 60分钟 为「强多/偏多」(开空为「强空/偏空」)
#   ② 15分钟 RSI: 最近 REGIME_COMBO_LOOKBACK_15M 根收盘内出现过超卖 (开空为超买过)
#   ③ 1分钟 Delta: 转强确认窗口内 (最近 MTF_COMBO_DELTA_BARS 根已收盘 1m K 线) 累计
#      主动买盘>卖盘 (开空为卖盘>买盘), 不看单独一根避免单根绿/红柱的偶然性
# 过滤不过 → 跳过下单并保持武装 (推飞书说明哪条没过)
# ⭐ 市价单: 走「一键追单」同通道 (manualFollowImpl: 立即市价成交, TP/SL 按 ATR 派生, 置信度小仓位)
# ⭐ 单次武装: 成功开仓后只关闭该方向开关 (被拒/过滤不过时保持武装等下一次转变)
# ⭐ 1分钟确认转为强多/强空时, 无论开关是否武装都推飞书
# 开关通过页面 / POST /api/regime/mtf-auto-open {enabledLong?, enabledShort?} 控制并持久化, 以下仅为行为参数:
#   MTF5_AUTO_OPEN_CONFIRM      1分钟状态确认所需连续新快照数 (默认 2, MTF 90s 刷新 ≈ 3 分钟)
#   MTF5_AUTO_OPEN_COOLDOWN_MS  两次自动触发的最小间隔 (默认 600000 = 10 分钟, 兜底)
#   MTF_COMBO_DELTA_BARS        Delta 累计统计的已收盘 1m K 线根数 (默认 3 ≈ 确认窗口时长)
MTF5_AUTO_OPEN_CONFIRM=2
MTF5_AUTO_OPEN_COOLDOWN_MS=600000
MTF_COMBO_DELTA_BARS=3


# ============ Telegram VIP 群组「交易信号」推送 ============
# 仅在交易动作切换 (转入做多/做空/观望) 时推送, 内容仅含交易参数
# 机器人需要：
#   1) 通过 BotFather 创建并拿到 token
#   2) 加入目标群组并被设置为「管理员」(开启发消息、踢人权限)
#   3) 群组若是超级群组 (supergroup), chat_id 为 -100 开头的负数
TELEGRAM_BOT_TOKEN=
TELEGRAM_VIP_GROUP_ID=

# 关闭推送：设为 0
TELEGRAM_PUSH_ENABLED=1
# 单次推送超时 (毫秒)
TELEGRAM_TIMEOUT_MS=8000

AUTO_TRADE_STREAM=btcusdt@aggTrade
AUTO_TRADE_EVAL_THROTTLE_MS=200
# ============ 自动平仓引擎 (trading 模块) ============
# 启动后默认监听 BTCUSDT.P, 接收外部 webhook 信号 → 登记仓位 → WS 价格触发 TP/SL → 出站 webhook
# 路由: POST /api/auto-trade/signal  /reset  GET /status /config
#
# 出站 webhook (即外部交易执行端入口) 与校验 token, 已内置默认值:
#   webhookUrl = https://transpenetrable-shantel-unabortively.ngrok-free.dev/webhook/wh_d113d9b4d838dbd635d4c19c3f0c51d9
#   token      = wh_d113d9b4d838dbd635d4c19c3f0c51d9
# 想覆盖请取消下面注释:
# AUTO_TRADE_WEBHOOK_URL=https://your-domain/webhook/xxx
# AUTO_TRADE_WEBHOOK_TOKEN=wh_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AUTO_TRADE_ENABLED=1                     # 设为 0 临时停用风控
# AUTO_TRADE_CONFIG_PATH=./data/auto_trade_config.json
# AUTO_TRADE_STATE_PATH=./data/auto_trade_state.json

# --- Binance WebSocket 代理 (中国大陆/境内服务器必填) ---
# 不配置代理时, 会出现 "Opening handshake has timed out", 因为直连无法到达 fstream.binance.com
# 支持 http(s):// 和 socks5://
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=socks5://127.0.0.1:1080
#
# (可选) 自定义 WS 节点 / 握手超时 (默认 20000ms):
# BINANCE_WS_BASE=wss://fstream.binance.com/ws
# BINANCE_WS_HANDSHAKE_MS=20000
#
# 注：实际运行时配置以 data/auto_trade_config.json 为准 (后台 POST /api/auto-trade/config 可热更新)

# ============ 交易点位监控系统 webhook (独立通道) ============
# 与 AUTO_TRADE_WEBHOOK_* 完全独立: 后者把"实际下单/平仓"信号转发给执行端;
# 这里把"开仓/挂单/止盈/止损/取消挂单"事件推送给行情监控/盯盘大屏, 用作可视化与归档.
#
# 共两个接口:
#   1) MONITOR_OPEN_WEBHOOK_URL    挂单/开仓/TP/SL 触发时 POST 完整 payload:
#         {"symbol":"BTCUSDT","side":"LONG","entry":..,"tp1":..,"tp2":..,"tp3":..,"sl":..,"comment":".."}
#   2) MONITOR_CANCEL_WEBHOOK_URL  取消挂单/一键全平时 POST: {"symbol":"BTCUSDT","side":"LONG"}
#
# 鉴权: HTTP Header  Authorization: Bearer <MONITOR_WEBHOOK_TOKEN>
# 不配置 URL 时静默禁用, 不会报错也不会阻塞主流程.
MONITOR_OPEN_WEBHOOK_URL=https://tradingdata.24os.cn/webhook
MONITOR_CANCEL_WEBHOOK_URL=https://tradingdata.24os.cn/webhook/cancel
MONITOR_WEBHOOK_TOKEN=please_change_me_to_a_long_random_string
MONITOR_WEBHOOK_ENABLED=1
MONITOR_WEBHOOK_TIMEOUT_MS=10000
# TLS 证书校验: 默认 strict (用 Node 内置根 + lib/certs/*.pem 补充根). 若监控端证书链
# 的根证书较新而本机 Node 太老导致 "unable to get local issuer certificate", 优先把缺失
# 的根证书 PEM 放进 lib/certs/ (推荐, 仍安全); 实在无法解决再临时设 =1 关闭校验 (不安全).
# MONITOR_WEBHOOK_INSECURE_TLS=0
# TLS: 监控通道默认严格校验, 并额外加载 lib/certs/*.pem 把缺失的根证书补进来
#   (老版本 Node 内置 CA 不含较新 Sectigo R46 根, 会报 "unable to get local issuer certificate")
# 仅在补根证书仍无法解决、且确认目标是自己可信的内网/服务时, 才临时设 1 关闭校验:
# MONITOR_WEBHOOK_INSECURE_TLS=0

# ============ DeepSeek AI 行情分析模块 (aitrade.24os.cn) ============
# 作为独立子模块挂载到 /api/regime/ai-analysis, 不影响原 regime 功能.
# 可用接口:
#   POST   /api/regime/ai-analysis/signals             手动提交一条信号
#   PATCH  /api/regime/ai-analysis/signals[/:id]       增量补充 (默认最新一条)
#   GET    /api/regime/ai-analysis/signals             列表 (?symbol=&limit=&offset=)
#   GET    /api/regime/ai-analysis/signals/:id         详情 + AI 分析报告
#   POST   /api/regime/ai-analysis/build-from-regime   用当前 Regime+资金费率自动组装并提交
AI_ANALYSIS_BASE_URL=https://aitrade.24os.cn
AI_ANALYSIS_TIMEOUT_MS=15000
# 设为 0 临时关闭 AI 分析通道 (不影响其他模块)
AI_ANALYSIS_ENABLED=1

# ============ 手动追单 / 手动开仓 回退价位百分比 ============
# 用于:
#   - 手动追单 (一键立即市价): entry-TP1, TP1-TP2, TP2-TP3, entry-SL 各按这个百分比
#   - 手动开仓 (挂单), 在 regime tradePlan 不可用时, 同样的回退方案
# 每段距离必须落在 0.5% ~ 1.2% 之间, 校验失败会拒绝下单.
MANUAL_FALLBACK_PCT=1.0
# 仓位百分比 (按账户资金), 不写 % 号; 默认 10
MANUAL_FALLBACK_POSITION_PCT=10
